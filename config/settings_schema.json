      },
      {
        "type": "checkbox",
        "id": "card_show_hover_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "prod_card_show_swatches",
        "label": "Show swatches",
        "default": true
      },
      {
        "type": "text",
        "id": "swatch_option_name",
