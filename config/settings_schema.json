[
  {
    "name": "theme_info",
    "theme_name": "Skeleton Theme",
    "theme_version": "1.0",
    "theme_author": "Fabian Genell",
    "theme_documentation_url": "https://shopifythemes.dev/",
    "theme_support_url": "https://shopifythemes.dev/"
  },
  {
    "name": "Design",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1920,
        "step": 20,
        "unit": "px",
        "label": "Max page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "base_gap",
        "min": 15,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Base Gap",
        "default": 30
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "info": "Set to 50 for fully pill-shaped buttons",
        "default": 50
      },
      {
        "type": "select",
        "id": "cart_icon",
        "label": "Cart Icon",
        "options": [
          {
            "value": "shopping_basket",
            "label": "Shopping Basket"
          },
          {
            "value": "tote_bag",
            "label": "Tote Bag"
          },
          {
            "value": "shopping_cart",
            "label": "Shopping Cart"
          }
        ],
        "default": "shopping_basket"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "inter_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "font_logo",
        "label": "Logo Font",
        "default": "inter_n7"
      },
      {
        "type": "header",
        "content": "Capitalization"
      },
      {
        "type": "checkbox",
        "id": "capitalize_headings",
        "label": "Capitalize headings",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "capitalize_logo",
        "label": "Capitalize logo",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "capitalize_navigation",
        "label": "Capitalize navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "capitalize_buttons",
        "label": "Capitalize buttons",
        "default": true
      },
      {
        "type": "header",
        "content": "Font Sizes"
      },
      {
        "type": "range",
        "id": "logo_base_size",
        "min": 12,
        "max": 48,
        "step": 1,
        "unit": "px",
        "label": "Logo font size",
        "default": 24
      },
      {
        "type": "range",
        "id": "heading_base_size",
        "min": 16,
        "max": 64,
        "step": 1,
        "unit": "px",
        "label": "Heading base size",
        "default": 32
      },
      {
        "type": "range",
        "id": "body_base_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Body base size",
        "default": 16
      },
      {
        "type": "range",
        "id": "navigation_base_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Navigation font size",
        "default": 16
      },
      {
        "type": "header",
        "content": "Letter Spacing"
      },
      {
        "type": "range",
        "id": "logo_letter_spacing",
        "min": -50,
        "max": 200,
        "step": 10,
        "unit": "em",
        "label": "Logo letter spacing",
        "default": 0
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -50,
        "max": 200,
        "step": 10,
        "unit": "em",
        "label": "Heading letter spacing",
        "default": 0
      },
      {
        "type": "range",
        "id": "body_letter_spacing",
        "min": -50,
        "max": 200,
        "step": 10,
        "unit": "em",
        "label": "Body letter spacing",
        "default": 0
      },
      {
        "type": "range",
        "id": "navigation_letter_spacing",
        "min": -50,
        "max": 200,
        "step": 10,
        "unit": "em",
        "label": "Navigation letter spacing",
        "default": 0
      },
      {
        "type": "range",
        "id": "buttons_letter_spacing",
        "min": -50,
        "max": 200,
        "step": 10,
        "unit": "em",
        "label": "Button letter spacing",
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile Scaling"
      },
      {
        "type": "range",
        "id": "heading_mobile_base_scale",
        "min": 0.5,
        "max": 1.5,
        "step": 0.1,
        "label": "Heading mobile scale",
        "default": 0.8
      },
      {
        "type": "range",
        "id": "body_mobile_base_scale",
        "min": 0.5,
        "max": 1.5,
        "step": 0.1,
        "label": "Body mobile scale",
        "default": 0.9
      }
    ]
  },
