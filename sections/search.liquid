<section class="page-width py-8 md:py-12">
  <header class="mb-8">
    {% if search.performed %}
      <h1 class="h2 mb-4">
        {% if search.results_count > 0 %}
          {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count | default: search.terms }}
        {% else %}
          {{ 'templates.search.no_results' | t: terms: search.terms | default: 'No results for' }} "{{ search.terms }}"
        {% endif %}
      </h1>
    {% else %}
      <h1 class="h2 mb-4">{{ 'general.search.search' | t | default: 'Search' }}</h1>
    {% endif %}

    <form action="{{ routes.search_url }}" method="get" role="search" class="max-w-2xl">
      <div class="relative">
        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
          {% render 'icon', icon: 'search' %}
        </div>
        <input
          type="search"
          name="q"
          class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-[var(--color-border)] rounded-lg text-base placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-black transition-all"
          placeholder="{{ 'general.search.placeholder' | t | default: 'Search products…' }}"
          value="{{ search.terms | escape }}"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        >
      </div>
    </form>
  </header>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-6">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {%- render 'product-card', product: item -%}
              {%- when 'article' -%}
                <a href="{{ item.url }}" class="block no-decoration">
                  {%- if item.image -%}
                    <div class="media pb-[60%] bg-gray-50 rounded-lg mb-3">
                      {% render 'image', image: item.image, src_width: 600, class: 'img-fit' %}
                    </div>
                  {%- endif -%}
                  <h3 class="text-lg font-medium">{{ item.title }}</h3>
                  {%- if item.excerpt != blank -%}
                    <p class="text-sm text-gray-600 mt-1">{{ item.excerpt | strip_html | truncatewords: 20 }}</p>
                  {%- endif -%}
                </a>
              {%- when 'page' -%}
                <a href="{{ item.url }}" class="block no-decoration p-4 border border-[var(--color-border)] rounded-lg">
                  <h3 class="text-lg font-medium">{{ item.title }}</h3>
                  {%- if item.content != blank -%}
                    <p class="text-sm text-gray-600 mt-1">{{ item.content | strip_html | truncatewords: 20 }}</p>
                  {%- endif -%}
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="mt-8">
          {%- render 'pagination', paginate: paginate -%}
        </div>
      {%- endpaginate -%}
    {%- else -%}
      <div class="text-center py-16 max-w-md mx-auto">
        <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
          {% render 'icon', icon: 'search' %}
        </div>
        <p class="text-gray-600 mb-8">
          {{ 'templates.search.no_results_text' | t | default: 'Try a different search.' }}
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary inline-flex">
          {{ 'templates.search.browse_all_products' | t | default: 'Browse all products' }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "enabled_on": {
    "templates": ["search"]
  },
  "limit": 1,
  "settings": []
}
{% endschema %}
