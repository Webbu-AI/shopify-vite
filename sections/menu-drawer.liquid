{%- liquid
  assign menu = section.settings.menu
-%}

<menu-drawer class="drawer drawer-left bg-white text-[var(--color-text)]" data-toggle-attribute="data-toggle-menu">
  <div class="h-full grid grid-rows-[auto_1fr]">
    {%- comment -%} Header {%- endcomment -%}
    <div class="flex justify-between items-center px-6 py-5 border-b border-[var(--color-border)]">
      <h2 class="text-lg font-medium">
        {{ section.settings.heading | default: 'Menu' }}
      </h2>
      <button
        type="button"
        class="w-8 h-8 flex items-center justify-center tap-target hover:bg-gray-100 rounded transition-colors"
        data-toggle-menu
        aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
      >
        {%- render 'icon', icon: 'close', class: 'w-5 h-5' -%}
      </button>
    </div>

    {%- comment -%} Nav {%- endcomment -%}
    <nav class="overflow-y-auto">
      {%- if menu != blank and menu.links.size > 0 -%}
        <ul>
          {%- for link in menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="block px-6 py-4 text-base no-decoration border-b border-[var(--color-border)] hover:bg-gray-50 transition-colors"
                {% if link.current %}aria-current="page"{% endif %}
                data-toggle-menu
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Footer links {%- endcomment -%}
      <div class="px-6 py-6 space-y-3">
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{{ routes.account_url }}"
            class="block text-sm no-decoration hover:opacity-70 transition-opacity"
          >
            {{ 'customers.account.title' | t | default: 'Account' }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_search_link -%}
          <button
            type="button"
            class="block text-sm hover:opacity-70 transition-opacity"
            data-toggle-menu
            data-toggle-search
          >
            {{ 'general.search.search' | t | default: 'Search' }}
          </button>
        {%- endif -%}
      </div>
    </nav>
  </div>
</menu-drawer>

<div class="overlay" data-toggle-menu></div>

{% schema %}
{
  "name": "Menu Drawer",
  "limit": 1,
  "tag": "aside",
  "class": "drawer-section",
  "enabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search_link",
      "label": "Show search link",
      "default": true
    }
  ]
}
{% endschema %}
