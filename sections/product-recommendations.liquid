    {
      "type": "select",
      "id": "grid_gap",
      "label": "Grid Gap",
      "options": [
        { "value": "gap-0", "label": "None" },
        { "value": "gap-1", "label": "Extra Small" },
        { "value": "gap-2", "label": "Small" },
        { "value": "gap-3", "label": "Medium" },
        { "value": "gap-4", "label": "Large" },
        { "value": "gap-6", "label": "Extra Large" },
        { "value": "gap-8", "label": "2X Large" }
      ],
      "default": "gap-3"
    },
    {
      "type": "header",
      "content": "Recommendation Settings"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Intent",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complimentary",
          "label": "Complimentary"
        }
      ],
      "default": "related"
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "settings": {}
    }
  ]
}
{% endschema %}
