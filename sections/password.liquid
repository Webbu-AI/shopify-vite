{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
-%}

<div class="relative min-h-screen flex items-center justify-center p-4 md:p-8">
  {%- if section.settings.background_image != blank -%}
    <div class="absolute inset-0 -z-10">
      {% render 'image',
        image: section.settings.background_image,
        widths: '640, 960, 1280, 1920, 2560',
        src_width: 1920,
        sizes: '100vw',
        class: 'img-fit',
        lazy_load: false
      %}
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
  {%- endif -%}

  <div class="max-w-lg w-full bg-white text-black p-8 md:p-12 rounded-lg shadow-2xl text-center">
    {%- if section.settings.logo != blank -%}
      <div class="mb-8">
        {% render 'image',
          image: section.settings.logo,
          src_width: 200,
          srcset_2x: true,
          lazy_load: false,
          class: 'inline-block max-w-[160px]'
        %}
      </div>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="h3 mb-3">{{ heading }}</h1>
    {%- endif -%}

    {%- if subheading != blank -%}
      <div class="text-base mb-8 rte">{{ subheading }}</div>
    {%- endif -%}

    {%- if section.settings.show_email_form -%}
      <div class="mb-8">
        {%- if section.settings.email_form_heading != blank -%}
          <p class="text-sm mb-4">{{ section.settings.email_form_heading }}</p>
        {%- endif -%}

        {% form 'customer', class: 'flex gap-2' %}
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <input
            type="email"
            name="contact[email]"
            class="flex-1 px-3 py-2 border border-[var(--color-border)] rounded"
            placeholder="you@example.com"
            required
            aria-label="Email"
          >
          <button type="submit" class="btn btn--primary !min-w-0 !py-2 !px-4">
            {{ 'general.password_page.submit' | t | default: 'Submit' }}
          </button>
        {% endform %}
      </div>
    {%- endif -%}

    <div class="text-xs text-gray-600 pt-6 border-t border-[var(--color-border)]">
      <p>{{ 'general.password_page.login_form_heading' | t | default: 'Are you the store owner?' }}</p>
      <a href="#login" class="link">{{ 'general.password_page.login_form_password_button' | t | default: 'Enter using password' }}</a>
    </div>

    <div id="login" class="hidden target:block mt-6">
      {% form 'storefront_password' %}
        <div class="flex gap-2">
          <input
            type="password"
            name="password"
            class="flex-1 px-3 py-2 border border-[var(--color-border)] rounded"
            placeholder="Password"
            aria-label="Password"
          >
          <button type="submit" class="btn btn--primary !min-w-0 !py-2 !px-4">
            {{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="text-sm text-red-600 mt-2">{{ form.errors.translated_messages.form }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "limit": 1,
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Get notified when we launch.</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_email_form",
      "label": "Show email form",
      "default": true
    },
    {
      "type": "text",
      "id": "email_form_heading",
      "label": "Email form heading",
      "default": "Be the first to know"
    }
  ]
}
{% endschema %}
