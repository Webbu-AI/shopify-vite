{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign height = section.settings.height
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01
  assign text_align = section.settings.text_align
  assign content_position = section.settings.content_position
  assign content_color = section.settings.content_color
-%}

<section
  class="image-banner relative w-full overflow-hidden {{ height }} {{ content_position }} {{ text_align }} flex"
  style="--content-color: {{ content_color }};"
>
  {%- comment -%} Background image {%- endcomment -%}
  <div class="absolute inset-0 -z-0">
    {%- if image != blank or image_mobile != blank -%}
      {% render 'pictures',
        breakpoints: '600, 1200, 2400',
        image_600: image_mobile,
        image_1200: image,
        image_2400: image,
        widths: '600, 900, 1200, 1800, 2400',
        sizes: '100vw',
        class: 'img-fit',
        section_index: section.index,
        lazy_load: false
      %}
    {%- else -%}
      <div class="absolute inset-0 bg-gray-100 flex items-center justify-center">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-200' }}
      </div>
    {%- endif -%}

    {%- if overlay_opacity > 0 -%}
      <div class="absolute inset-0 bg-black pointer-events-none" style="opacity: {{ overlay_opacity }};"></div>
    {%- endif -%}
  </div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="relative z-10 page-width w-full">
    <div class="max-w-xl text-[var(--content-color)] space-y-4 py-12 md:py-16">
      {%- if section.settings.subheading != blank -%}
        <p class="text-xs uppercase tracking-widest">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h1 font-medium">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="text-base md:text-lg max-w-md">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="pt-2">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="btn {{ section.settings.button_style }}"
          >
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional — defaults to the desktop image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "min-h-[320px] md:min-h-[400px]", "label": "Small" },
        { "value": "min-h-[420px] md:min-h-[520px]", "label": "Medium" },
        { "value": "min-h-[520px] md:min-h-[640px]", "label": "Large" },
        { "value": "min-h-screen", "label": "Full screen" }
      ],
      "default": "min-h-[420px] md:min-h-[520px]"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to the store"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A short intro that tells visitors what you sell and why they should care.</p>"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center justify-center", "label": "Center" },
        { "value": "text-right justify-end", "label": "Right" }
      ],
      "default": "text-left"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical position",
      "options": [
        { "value": "items-start", "label": "Top" },
        { "value": "items-center", "label": "Middle" },
        { "value": "items-end", "label": "Bottom" }
      ],
      "default": "items-center"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" }
      ],
      "default": "btn--primary"
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ]
}
{% endschema %}
