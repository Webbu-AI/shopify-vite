<div class="page-width py-8 md:py-12">
  <h1 class="h2 mb-8">{{ blog.title }}</h1>

  {%- paginate blog.articles by section.settings.articles_per_page -%}
    {%- if blog.articles.size > 0 -%}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        {%- for article in blog.articles -%}
          <article>
            <a href="{{ article.url }}" class="block no-decoration group">
              {%- if article.image -%}
                <div class="media pb-[66%] bg-gray-50 rounded-lg mb-4 overflow-hidden">
                  {% render 'image',
                    image: article.image,
                    src_width: 800,
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                    class: 'img-fit transition-transform duration-500 group-hover:scale-105'
                  %}
                </div>
              {%- endif -%}

              {%- if section.settings.show_date -%}
                <p class="text-xs uppercase tracking-widest text-gray-600 mb-2">
                  {{ article.published_at | time_tag: format: 'date' }}
                </p>
              {%- endif -%}

              <h2 class="text-lg font-medium mb-2 group-hover:opacity-70 transition-opacity">
                {{ article.title }}
              </h2>

              {%- if article.excerpt != blank -%}
                <p class="text-sm text-gray-600 line-clamp-3">{{ article.excerpt | strip_html }}</p>
              {%- endif -%}

              {%- if section.settings.show_author -%}
                <p class="text-xs text-gray-600 mt-3">{{ article.author }}</p>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="mt-12">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="py-16 md:py-24 text-center max-w-md mx-auto">
        <p class="text-gray-600">{{ 'blog.no_articles' | t | default: 'No articles yet.' }}</p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    }
  ]
}
{% endschema %}
