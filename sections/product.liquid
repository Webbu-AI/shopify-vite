{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="product page-width py-8 md:py-12" data-section="{{ section.id }}">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-start">
    {%- comment -%} Product gallery {%- endcomment -%}
    <div class="product__media">
      {%- if product.media.size > 0 -%}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {%- for media in product.media -%}
            <div class="media pb-[100%] bg-gray-50 rounded-lg {% if forloop.length == 1 or forloop.first and forloop.length == 3 %}md:col-span-2{% endif %}">
              {% render 'image',
                image: media.preview_image,
                src_width: 1200,
                widths: '400, 600, 800, 1200',
                sizes: '(min-width: 768px) 25vw, 100vw',
                class: 'img-fit',
                lazy_load: forloop.first == false
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="media pb-[100%] bg-gray-50 rounded-lg flex items-center justify-center">
          {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-contain text-gray-300' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="product__info md:sticky md:top-24">
      {%- if product.vendor != blank -%}
        <p class="text-xs uppercase tracking-widest text-gray-600 mb-2">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="h3 mb-4">{{ product.title }}</h1>

      <div class="text-xl mb-6">
        {%- render 'price', product: product -%}
      </div>

      <product-form>
        <div class="js-form-error" role="alert" hidden></div>

        {%- form 'product', product, id: product_form_id, class: 'js-product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- if product.has_only_default_variant == false -%}
            <div class="mb-6 space-y-4">
              {%- for option in product.options_with_values -%}
                <div>
                  <label class="block text-sm font-medium mb-2" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                    {{ option.name }}
                  </label>
                  <select
                    id="Option-{{ section.id }}-{{ forloop.index0 }}"
                    name="options[{{ option.name }}]"
                    class="w-full border border-[var(--color-border)] rounded px-3 py-2"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="flex items-center gap-3 mb-6">
            <quantity-input class="flex items-center border border-[var(--color-border)] rounded">
              <button type="button" name="minus" class="w-10 h-10 flex items-center justify-center" aria-label="Decrease quantity">
                {%- render 'icon', icon: 'minus' -%}
              </button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="input w-12 text-center"
                aria-label="Quantity"
              >
              <button type="button" name="plus" class="w-10 h-10 flex items-center justify-center" aria-label="Increase quantity">
                {%- render 'icon', icon: 'plus' -%}
              </button>
            </quantity-input>
          </div>

          <button
            type="submit"
            name="add"
            class="btn btn--primary w-full"
            {% if current_variant.available == false %}disabled{% endif %}
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="mt-3">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </product-form>

      {%- if product.description != blank -%}
        <div class="rte mt-8">
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_share -%}
        <div class="mt-8 pt-6 border-t border-[var(--color-border)]">
          <p class="text-sm">
            <a href="{{ shop.url }}{{ product.url }}" class="link">
              {{ 'products.product.share' | t | default: 'Share' }}
            </a>
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
