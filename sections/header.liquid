{%- liquid
  assign logo = section.settings.logo
  assign menu = section.settings.menu
-%}

<header class="header-section bg-[var(--color-header-bg)] text-[var(--color-header-text)]">
  <div class="grid grid-cols-[1fr_auto_1fr] md:flex items-center gap-4 py-3 md:py-4 page-width">
    {%- comment -%} Mobile menu toggle {%- endcomment -%}
    <div class="flex items-center md:hidden">
      <button
        type="button"
        class="size-[40px] flex items-center justify-center tap-target"
        aria-label="Open menu"
        data-toggle-menu
      >
        {%- render 'icon', icon: 'hamburger' -%}
      </button>
    </div>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="block md:mt-1 mr-auto ml-auto md:ml-0 no-decoration">
      {%- if logo != blank -%}
        {% render 'image',
          image: logo,
          src_width: 200,
          srcset_2x: true,
          lazy_load: false,
          class: 'w-[100px] md:w-[120px]'
        %}
      {%- else -%}
        <span class="text-2xl font-bold font-[var(--font-logo)]">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Desktop nav {%- endcomment -%}
    <nav class="hidden md:flex flex-1 justify-center group">
      {%- for link in menu.links -%}
        <a
          class="text-base py-2 px-4 whitespace-nowrap flex items-center group-hover:opacity-70 transition-opacity duration-300 hover:!opacity-100 no-decoration"
          href="{{ link.url }}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    {%- comment -%} Header icons {%- endcomment -%}
    <div class="flex items-center justify-end gap-1 md:gap-2">
      {%- if section.settings.show_search -%}
        <a
          href="{{ routes.search_url }}"
          class="p-2 tap-target no-decoration"
          aria-label="Search"
        >
          {%- render 'icon', icon: 'search' -%}
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="p-2 tap-target no-decoration hidden md:inline-flex"
          aria-label="Account"
        >
          {%- render 'icon', icon: 'account' -%}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="relative p-2 tap-target no-decoration"
        aria-label="Cart"
        data-cart-link
      >
        {%- render 'icon', icon: 'cart' -%}
        {%- if cart.item_count > 0 -%}
          <sup class="absolute top-0 right-0 bg-black text-white text-[10px] leading-none rounded-full size-[18px] flex items-center justify-center" data-cart-count>
            {{ cart.item_count }}
          </sup>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "class": "sticky top-0 z-50 header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
