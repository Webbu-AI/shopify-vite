{%- liquid
  assign show_title = section.settings.show_title
-%}

<div class="page-width py-8 md:py-12">
  {%- if show_title -%}
    <header class="mb-8 text-center">
      <h1 class="h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte mt-3 max-w-2xl mx-auto">{{ collection.description }}</div>
      {%- endif -%}
      {%- if section.settings.show_product_count -%}
        <p class="text-sm text-gray-600 mt-2">
          {{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}
        </p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if collection.products_count > 0 -%}
    {%- paginate collection.products by 24 -%}
      <infinite-collection class="block">
        <div class="js-filter-results grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-6">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product, collection: collection -%}
          {%- endfor -%}
        </div>
        <div class="mt-8">
          {%- render 'pagination', paginate: paginate -%}
        </div>
      </infinite-collection>
    {%- endpaginate -%}
  {%- else -%}
    <div class="py-16 text-center max-w-md mx-auto">
      <h2 class="h3 mb-4">{{ 'sections.collection_template.empty' | t | default: 'No products yet' }}</h2>
      <p class="text-gray-600 mb-8">
        {{ 'sections.collection_template.empty_text' | t | default: 'Check back soon.' }}
      </p>
      <a href="{{ routes.collections_url }}" class="btn btn--primary inline-flex">
        {{ 'sections.collection_template.browse_collections' | t | default: 'Browse collections' }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection"
    }
  ]
}
{% endschema %}
