{%- liquid
  assign collection = section.settings.collection
  assign products_shown = section.settings.products_shown
  assign columns = section.settings.columns
-%}

<div class="featured-collection py-8 md:py-12">
  <div class="page-width">
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-3 mb-6">
      {%- if section.settings.title != blank -%}
        <h2 class="h3">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if collection and section.settings.show_view_all -%}
        <a href="{{ collection.url }}" class="text-sm underline self-start md:self-auto">
          {{ section.settings.button_label | default: 'View all' }}
        </a>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="grid grid-cols-2 {{ columns }} gap-3 md:gap-6">
        {%- for product in collection.products limit: products_shown -%}
          {%- render 'product-card', product: product, collection: collection -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid grid-cols-2 {{ columns }} gap-3 md:gap-6">
        {%- assign placeholder_count = products_shown | at_most: 4 -%}
        {%- for i in (1..placeholder_count) -%}
          <div>
            <div class="media aspect-square bg-gray-50 rounded-lg overflow-hidden flex items-center justify-center">
              {{ 'product-1' | placeholder_svg_tag: 'max-w-[60%] h-auto text-gray-300' }}
            </div>
            <div class="pt-3">
              <p class="text-xs uppercase tracking-widest text-gray-600 mb-1">Brand</p>
              <h3 class="text-base font-medium">Product title</h3>
              <p class="text-sm mt-1">{{ 12345 | money }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_shown",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "md:grid-cols-2", "label": "2" },
        { "value": "md:grid-cols-3", "label": "3" },
        { "value": "md:grid-cols-4", "label": "4" }
      ],
      "default": "md:grid-cols-4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
