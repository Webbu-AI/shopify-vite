{
  "sections": {
    "image-banner": {
      "type": "image-banner",
      "settings": {
        "subheading": "New collection",
        "heading": "Welcome to the store",
        "text": "<p>A clean, fast Shopify theme starter. Replace this banner with your hero image and intro copy.</p>",
        "button_label": "Shop the collection",
        "button_link": "/collections/frontpage",
        "button_style": "btn--primary",
        "height": "min-h-[420px] md:min-h-[520px]",
        "overlay_opacity": 40,
        "content_color": "#ffffff",
        "text_align": "text-left",
        "content_position": "items-center"
      }
    },
    "featured-collection": {
      "type": "featured-collection",
      "settings": {
        "title": "Featured",
        "collection": "frontpage",
        "products_shown": 8,
        "columns": "md:grid-cols-4",
        "show_view_all": true
      }
    },
    "collection-list": {
      "type": "collection-list",
      "blocks": {
        "block-1": { "type": "collection", "settings": { "custom_title": "Bestsellers", "button_text": "Shop now" } },
        "block-2": { "type": "collection", "settings": { "custom_title": "New arrivals", "button_text": "Shop now" } },
        "block-3": { "type": "collection", "settings": { "custom_title": "Sale", "button_text": "Shop now" } }
      },
      "block_order": ["block-1", "block-2", "block-3"],
      "settings": {
        "title": "Shop by collection",
        "columns_mobile": "grid-cols-1",
        "columns_desktop": "md:grid-cols-3"
      }
    },
    "text-banner": {
      "type": "text-banner",
      "settings": {
        "subheading": "About",
        "heading": "Built for speed",
        "text": "<p>A minimal Shopify theme starter — Tailwind, Vite, and a clean set of building blocks.</p>"
      }
    }
  },
  "order": [
    "image-banner",
    "featured-collection",
    "collection-list",
    "text-banner"
  ]
}
