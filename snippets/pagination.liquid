<!-- /snippets/pagination-custom.liquid -->
{% comment %}
  {% render 'pagination-custom', paginate: paginate %}
{% endcomment %}

{% if paginate.pages > 1 %}
  <ul class="sr-only js-pagination">
    {% if paginate.previous %}
      <li>
        <a href="{{ paginate.previous.url }}" title="{{ paginate.previous.title }}">
          <span class="">{{ paginate.previous.title }}</span>
        </a>
      </li>
    {% else %}
      <li>
        <span>
          <span class="">{{ paginate.current_page }}</span>
        </span>
      </li>
    {% endif %}
    {% for part in paginate.parts %}
      {% if part.is_link %}
        <li class="">
          <a href="{{ part.url }}" title="">{{ part.title }}</a>
        </li>
      {% else %}
        {% if part.title == paginate.current_page %}
          <li class="">
            <span>
              <span>
                {{ part.title }}
              </span>
            </span>
          </li>
        {% else %}
          <li class="">
            <span>{{ part.title }}</span>
          </li>
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if paginate.next %}
      <li class="">
        <a data-next-page-link href="{{ paginate.next.url }}" title="{{ paginate.next.title }}">
          <span class="">{{ paginate.next.title }}</span></a
        >
      </li>
    {% else %}
      <li class="">
        <span>
          <span class="">{{ paginate.current_page }}</span>
        </span>
      </li>
    {% endif %}
  </ul>
{% endif %}
