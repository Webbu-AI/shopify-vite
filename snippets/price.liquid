{% doc %}
  Renders product pricing with support for price ranges, compare-at pricing, and normal pricing.

  @param {object} product - Product object
  @param {number} [normal_price] - Override normal price (defaults to product.price)
  @param {number} [compare_at_price] - Override compare at price (defaults to product.compare_at_price)

  @example
  {% render 'price', product: product %}
  @example
  {% render 'price', 
    product: product,
    normal_price: 50000,
    compare_at_price: 60000
  %}
{% enddoc %}

{%- liquid
  assign normal_price = normal_price | default: product.price
  assign compare_at_price = compare_at_price | default: product.compare_at_price

  assign use_price_range = false
  assign price_range_low = product.metafields.custom.price_range_low_end.value
  assign price_range_high = product.metafields.custom.price_range_high_end.value

  if price_range_low != blank and price_range_high != blank
    assign use_price_range = true
  endif
-%}

{%- if use_price_range -%}
  <span class="price-range"> {{ price_range_low | money }} - {{ price_range_high | money }} </span>
{%- else -%}
  {%- if compare_at_price < normal_price -%}
    <span class="price-compare">
      {{ compare_at_price | money }}
    </span>
  {%- endif -%}
  <span class="price-normal">
    {{ normal_price | money }}
  </span>
{%- endif -%}
