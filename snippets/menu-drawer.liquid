{% doc %}
  Mobile menu drawer. Toggled by buttons with `data-toggle-menu` attribute.

  @param {linklist} menu - The menu to render

  @example
  {% render 'menu-drawer', menu: section.settings.menu %}
{% enddoc %}

<div class="drawer drawer-left bg-white text-[var(--color-text)]" data-drawer="menu">
  <div class="h-full grid grid-rows-[auto_1fr] p-5 relative">
    <button
      type="button"
      class="ml-auto w-8 h-8 flex items-center justify-center tap-target"
      data-toggle-menu
      aria-label="Close menu"
    >
      {%- render 'icon', icon: 'close' -%}
    </button>

    <nav class="flex flex-col relative pt-6 overflow-y-auto pb-8">
      {%- for link in menu.links -%}
        <a
          href="{{ link.url }}"
          class="py-4 text-2xl no-decoration border-b border-[var(--color-border)]"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>
  </div>
</div>

<div class="overlay" data-toggle-menu></div>
